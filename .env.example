# bldr — Environment Variables
# Copy this to .env at the root and fill in real values

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bldr"

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── API ───────────────────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL="http://localhost:4000"

# ─── Frontend URLs (used by API for CORS) ──────────────────────────────────────
STOREFRONT_URL="http://localhost:3000"
PROVIDER_PORTAL_URL="http://localhost:3001"
ADMIN_PORTAL_URL="http://localhost:3002"

# ─── Frontend (used by Next.js apps) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"

# ─── Geidea (sandbox) ──────────────────────────────────────────────────────────
GEIDEA_MERCHANT_KEY="your-geidea-merchant-key"
GEIDEA_API_PASSWORD="your-geidea-api-password"
GEIDEA_BASE_URL="https://api.merchant.geidea.net"
GEIDEA_CHECKOUT_JS_URL="https://checkout-demo.geidea.net/geideaCheckout.min.js"
# Production: https://checkout.geidea.net/geideaCheckout.min.js

# ─── Fawry ─────────────────────────────────────────────────────────────────────
FAWRY_MERCHANT_CODE="your-fawry-merchant-code"
FAWRY_SECURITY_KEY="your-fawry-security-key"
FAWRY_BASE_URL="https://atfawry.fawrystaging.com"
# Production: https://www.atfawry.com

# ─── Default Gateway & Simulation ─────────────────────────────────────────────
PAYMENT_SIMULATION_MODE="true"
DEFAULT_PAYMENT_GATEWAY="geidea"

# ─── Commission ────────────────────────────────────────────────────────────────
# Default global commission rate (as decimal, e.g. 0.10 = 10%)
DEFAULT_COMMISSION_RATE="0.10"

# ─── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DEST="./uploads"
MAX_FILE_SIZE_MB="10"

# ─── Seed ──────────────────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL="admin@bldr.io"
ADMIN_SEED_PASSWORD="Admin@bldr2024!"
