{
  "name": "bldr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "ts-node --project tsconfig.seed.json apps/api/src/commission/commission.service.spec.ts && ts-node --project tsconfig.seed.json apps/api/src/webhooks/webhooks.service.spec.ts && ts-node --project tsconfig.seed.json apps/api/src/simulation/simulation.service.spec.ts",
    "db:start": "ts-node --project tsconfig.seed.json scripts/start-db.ts",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.7.5",
    "bcrypt": "^6.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  }
}
