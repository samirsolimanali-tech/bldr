// ─── Prisma Schema — BLDR Central Payment Hub ────────────────────────────────
// Naming convention: "brand" / "venture" throughout. The term "Provider" in
// model names below is legacy from when BLDR intended third-party sellers.
// Internally these are all BLDR-owned brands; the models are kept compatible
// to avoid a breaking migration but are treated arm's-length for accounting.
//
// PENDING NAMING MIGRATION (tracked in ARCH-001):
//   Provider model  →  Brand / Venture
//   providerId      →  ventureId
//   ProviderUser    →  VentureUser
//   CommissionRule  →  PlatformFeeRule
// This will be a single migration executed in Phase 2 once the checkout-session
// API is stable. Until then, use the alias annotations below as the source of
// truth for semantic meaning.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/// @alias VentureStatus — Active/suspended state of an internal BLDR brand.
enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PurchaseType {
  NATIVE    // Student checked out inside BLDR native storefront (Model A)
  REDIRECT  // External LMS redirected to BLDR checkout session (Model B)
}

enum EngagementType {
  BUY_NOW
  REQUEST_QUOTE
  BOOK_CALL
}

enum OrderStatus {
  PENDING
  PENDING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

enum OrderSource {
  NATIVE
  REDIRECT
}

enum GatewayType {
  GEIDEA
  PAYMOB
  FAWRY
  EXTERNAL
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum UserRole {
  ADMIN
  APPROVER
  PROVIDER  // @alias VENTURE_TEAM_MEMBER
  CUSTOMER
}

/// Which PSP handles Card & Wallet transactions for a given venture.
/// Exactly one gateway per venture. No primary/fallback failover between the two.
/// Fawry is a separate, independent rail controlled by fawryEnabled on the Provider model.
enum CardWalletGateway {
  GEIDEA   // Geidea hosted checkout — pilot default for bldr storefront
  PAYMOB   // Paymob (Accept) hosted iframe
}

/// Fee model applied at settlement time, before net is calculated for a brand.
enum PlatformFeeModel {
  PERCENTAGE         // e.g. 3.0% of gross
  FLAT_PER_TXN      // e.g. EGP 5.00 per order
  COMBINED           // percentage + flat fee per txn
}

/// Settlement statement status (generated weekly; approved by Finance Ops).
enum StatementStatus {
  DRAFT
  FINALISED
  DISPUTED
}

/// Integration mode for a brand — determines portal sidebar and API behaviour.
enum IntegrationMode {
  NATIVE    // Brand uses BLDR's own storefront + CRM (Model A)
  BOLT_ON   // Brand has external LMS; uses checkout-session API + webhook (Model B)
}

// ─── Models ───────────────────────────────────────────────────────────────────

/// @alias Brand / Venture — an internal BLDR brand. All brands are 100% owned
/// by bldr. Data is strictly isolated: queries MUST always filter by id/slug so
/// one brand team never sees another's transactions.
model Provider {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  tagline       String?
  bio           String?        @db.Text
  logoUrl       String?
  bannerUrl     String?
  website       String?
  isHouseBrand  Boolean        @default(true)  // Always true for internal brands
  status        ProviderStatus @default(APPROVED)
  rejectedReason String?
  conversionToken String?      @unique

  /// Integration model: NATIVE (Model A) or BOLT_ON (Model B / Hybrid)
  integrationMode IntegrationMode @default(NATIVE)

  // ─── Gateway Assignment ───────────────────────────────────────────────────
  // Card & Wallet: exactly one PSP per venture. No failover between Geidea/Paymob.
  // Default: GEIDEA (pilot configuration for bldr storefront).
  cardWalletGateway   CardWalletGateway @default(GEIDEA)

  // Fawry: independent rail. Toggle controls whether a Fawry reference-code
  // option appears on this venture's checkout page. Default: false (opt-in).
  // bldr storefront pilot: true (Fawry enabled alongside Geidea).
  fawryEnabled        Boolean @default(false)

  // Physical / Offline Code Activation: Gating toggle for whether students see
  // "Activate a Code / Serial" choice on the hosted checkout page.
  codeActivationEnabled Boolean @default(true)

  // ─── Platform Fee Configuration ──────────────────────────────────────────
  // Applied at settlement time. Finance Ops can edit per-brand. Never hardcoded.
  platformFeeModel    PlatformFeeModel @default(PERCENTAGE)
  platformFeePct      Decimal?         @db.Decimal(5, 4)  // e.g. 0.0300 = 3%
  platformFeeFlat     Int?             // minor units (piasters), e.g. 500 = EGP 5.00
  platformFeeNote     String?          // human-readable rationale for this brand's rate

  // ─── VAT on Fees Configuration ────────────────────────────────────────────
  // Controls whether VAT is applied to gateway fees + platform fee at settlement.
  // Both the on/off toggle and the rate are configurable per brand.
  vatOnFeesEnabled    Boolean          @default(false)
  vatRate             Decimal          @default(0.0000) @db.Decimal(5, 4) // default 0.00 until accountant signs off

  // ─── Reserve / Hold-Back ─────────────────────────────────────────────────
  // Internal risk buffer. Protects bldr's cash position against refund/chargeback.
  reservePct          Decimal  @default(0.05)  @db.Decimal(4, 4)  // 5% default
  reserveReleaseDays  Int      @default(14)    // days before reserve releases

  // ─── Payout / Settlement Policy ──────────────────────────────────────────
  payoutCadence       String   @default("weekly")   // "daily" | "weekly" | "manual"
  payoutMinThreshold  Int      @default(100000)     // piasters — EGP 1,000 default
  payoutDayOfWeek     Int?     // 0=Sun…6=Sat; null = manual only

  // ─── Model B — External LMS Integration ──────────────────────────────────
  // Used when integrationMode = BOLT_ON. Not needed for NATIVE brands.
  externalSuccessUrl  String?   // success_url template for redirect after payment
  externalCancelUrl   String?   // cancel_url for abandoned sessions
  externalWebhookUrl  String?   // BLDR fires order.paid events here (signed HMAC)
  externalWebhookSecret String? // Used to sign outbound events; generated on creation
  allowedOrigins      String[]  // Authorized domains for checkout-session requests

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users              ProviderUser[]
  listings           Listing[]
  orders             Order[]
  leads              Lead[]
  commissionRules    CommissionRule[]
  payouts            Payout[]
  trackingEvents     TrackingEvent[]
  checkoutSessions   CheckoutSession[]
  settlementStatements SettlementStatement[]
  enrollmentCodes    EnrollmentCode[]
  products           Product[]
}

/// @alias VentureUser — a bldr team member scoped to one specific brand.
/// RBAC boundary is enforced at the service layer: queries filter by providerId.
model ProviderUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(PROVIDER)
  providerId   String

  // RBAC permission flags within a brand's portal
  canViewBalances    Boolean @default(true)
  canConfigureRails  Boolean @default(false)
  canInitiateRefunds Boolean @default(false)
  canDownloadReports Boolean @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Model B: External Checkout Session ──────────────────────────────────────
// Created when an external LMS calls POST /v1/checkout/sessions.
// On completion, BLDR fires an outbound webhook to Provider.externalWebhookUrl.

model CheckoutSession {
  id             String   @id @default(cuid()) // cs_live_... / cs_test_...
  providerId     String   // @alias ventureId
  externalRef    String?  // order ID in the external LMS
  amountPiasters Int      // integer minor units — no decimals
  currency       String   @default("EGP")
  customerName   String?
  customerEmail  String
  customerPhone  String?
  lineItems      Json     // [{ id, title, quantity, unit_amount }]
  metadata       Json?    // attribution: utm_*, affiliate_code, lms_student_id
  successUrl     String
  cancelUrl      String
  allowedMethods String[] // e.g. ["cards", "wallets", "fawry"]
  status         String   @default("open")  // open | completed | expired | cancelled
  expiresAt      DateTime
  orderId        String?  // populated on completion
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id])
}

// ─── Settlement Statement (Brand-Level P&L) ───────────────────────────────────
// Generated by Finance Ops on the configured cadence. Each brand's team sees
// their own statement only — never another brand's.

model SettlementStatement {
  id              String          @id @default(cuid())
  providerId      String          // @alias ventureId

  periodStart     DateTime
  periodEnd       DateTime
  statementRef    String          @unique // e.g. STL-SH-2026-W39

  // Revenue line items (all in piasters — integer)
  grossPiasters          Int      // sum of paid order amounts
  gatewayFeesPiasters    Int      // PSP fees (Paymob, Fawry, etc.)
  platformFeePiasters    Int      // bldr internal platform fee
  vatOnFeesPiasters      Int      // VAT on platform + gateway fees
  refundsPiasters        Int      // refunds issued in period
  netPiasters            Int      // gross - fees - platform fee - vat - refunds

  // Reserve movement
  reserveHeldPiasters    Int      // amount moved into reserve this period
  reserveReleasedPiasters Int     // reserve released from prior periods
  reserveBalancePiasters  Int     // running reserve balance after this period

  // Metadata
  txnCount        Int
  refundCount     Int
  status          StatementStatus @default(DRAFT)
  finalisedAt     DateTime?
  note            String?         @db.Text

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  provider        Provider        @relation(fields: [providerId], references: [id])
}

// ─── Legacy models (unchanged) ───────────────────────────────────────────────

model Listing {
  id             String         @id @default(cuid())
  title          String
  description    String         @db.Text
  price          Decimal        @db.Decimal(12, 2)
  currency       String         @default("EGP")
  category       String
  tags           String[]
  mediaUrls      String[]
  purchaseType   PurchaseType   @default(NATIVE)
  engagementType EngagementType @default(BUY_NOW)
  redirectUrl    String?
  isFeatured     Boolean        @default(false)
  isPublished    Boolean        @default(false)
  providerId     String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  provider       Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  orders         Order[]
  leads          Lead[]
  trackingEvents TrackingEvent[]
}

model Lead {
  id             String         @id @default(cuid())
  listingId      String
  providerId     String
  name           String
  email          String
  phone          String?
  message        String?        @db.Text
  engagementType EngagementType
  status         LeadStatus     @default(NEW)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  listing  Listing  @relation(fields: [listingId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])
}

model Order {
  id                String      @id @default(cuid())
  listingId         String?
  productId         String?     // FK to authoritative Product
  productTitle      String?     // Snapshot of product title at purchase time
  productPriceMinor Int?        // Snapshot of price (in piasters) at purchase time
  providerId        String
  customerEmail     String
  customerName      String?
  amount            Decimal     @db.Decimal(12, 2)
  currency          String      @default("EGP")
  status            OrderStatus @default(PENDING)
  source            OrderSource @default(NATIVE)
  externalReference String?
  gatewayUsed       GatewayType
  gatewaySessionId  String?
  gatewayMetadata   Json?
  commissionAmount  Decimal?    @db.Decimal(12, 2)
  netAmount         Decimal?    @db.Decimal(12, 2)
  commissionRate    Decimal?    @db.Decimal(5, 4)
  platformFeeAmount Decimal?    @db.Decimal(12, 2)  // bldr internal fee at settlement
  trackingEventId   String?
  checkoutSessionId String?     // FK to CheckoutSession if created via Model B API
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  listing       Listing?       @relation(fields: [listingId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  provider      Provider       @relation(fields: [providerId], references: [id])
  trackingEvent TrackingEvent? @relation(fields: [trackingEventId], references: [id])
  transactions  Transaction[]
  payout        Payout?        @relation(fields: [payoutId], references: [id])
  payoutId      String?
}

// ─── Authoritative Product Catalog (PostgreSQL Single Source of Truth) ──────
model Product {
  id          String   @id @default(cuid())
  ventureId   String
  slug        String   @unique
  title_en    String
  title_ar    String
  description String?  @db.Text
  priceMinor  Int      // integer minor units (piasters: e.g. 480000 = 4,800.00 EGP)
  currency    String   @default("EGP")
  saleMode    String   @default("DIRECT") // DIRECT | REDIRECT
  redirectUrl String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE | DRAFT | ARCHIVED
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider    Provider @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([ventureId])
  @@index([status])
}

// ─── Forensic Audit Trail ──────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  entity    String   // e.g. "PRODUCT", "SETTLEMENT", "VENTURE"
  entityId  String
  action    String   // e.g. "CREATE", "UPDATE_PRICE", "UPDATE_STATUS", "OVERRIDE"
  actorId   String
  actorRole String?
  ventureId String?
  diff      Json?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([ventureId])
  @@index([createdAt])
}


model Transaction {
  id              String   @id @default(cuid())
  orderId         String
  rawPayload      Json
  signatureValid  Boolean  @default(false)
  gatewayRef      String?
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  clickId     String   @unique @default(cuid())
  listingId   String
  providerId  String
  redirectUrl String
  ipAddress   String?
  userAgent   String?
  referrer    String?
  createdAt   DateTime @default(now())

  listing  Listing  @relation(fields: [listingId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])
  orders   Order[]
}

/// @alias PlatformFeeRule — per-venture configurable platform fee.
/// Note: "CommissionRule" name is legacy; semantically this is bldr's internal
/// platform fee (equivalent of what a PayFac charges a merchant).
/// Phase 2 rename: CommissionRule → PlatformFeeRule, providerId → ventureId.
model CommissionRule {
  id         String   @id @default(cuid())
  providerId String?  // null = global default; @alias ventureId
  rate       Decimal  @db.Decimal(5, 4) // e.g. 0.0300 = 3%
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId])
}

model Payout {
  id               String       @id @default(cuid())
  providerId       String
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Decimal      @db.Decimal(12, 2)
  commissionAmount Decimal      @db.Decimal(12, 2)
  netAmount        Decimal      @db.Decimal(12, 2)
  status           PayoutStatus @default(PENDING)
  paidAt           DateTime?
  note             String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])
  orders   Order[]
}

// ─── Enrollment Codes & Offline Seat Activation ──────────────────────────────

enum EnrollmentCodeStatus {
  UNUSED
  USED
  EXPIRED
  VOID
}

enum EnrollmentCodeSource {
  PHYSICAL_STORE
  CENTER
  TUTOR
  BATCH_DISTRIBUTION
  OTHER
}

model EnrollmentCode {
  id                  String               @id @default(cuid())
  code                String               // Masked or display code (e.g. SH-***-F982)
  codeHash            String?              // SHA-256 hash of normalized code for secure lookup
  serial              String?
  ventureId           String
  productId           String?
  productName         String
  status              EnrollmentCodeStatus @default(UNUSED)
  source              EnrollmentCodeSource @default(CENTER)
  redeemedAt          DateTime?
  redeemedByEmail     String?
  redeemedByName      String?
  orderId             String?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  provider            Provider             @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@unique([ventureId, code])
  @@index([ventureId, codeHash])
  @@index([ventureId, status])
}

// ─── Activation Code Rate Limiting (DB-backed, survives restarts) ─────────────
model ActivationAttempt {
  id          String   @id @default(cuid())
  ipAddress   String
  ventureId   String
  attemptedAt DateTime @default(now())

  @@index([ipAddress, attemptedAt])
  @@index([ventureId, attemptedAt])
}
