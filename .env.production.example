# ═══════════════════════════════════════════════════════════════════════════════
# BLDR Central Payment Hub & SaaS — PRODUCTION ENVIRONMENT CONFIGURATION
# Set these variables in your Production Hosting dashboard (Vercel & Railway/Render)
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV="production"

# ─── 1. Managed Production Database (Neon / Supabase / Railway) ───────────────
# Example Neon: postgres://user:password@ep-sample-123456.us-east-2.aws.neon.tech/bldr?sslmode=require
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB_NAME>?sslmode=require"

# ─── 2. Production Authentication (JWT) ───────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="generate-a-long-secure-random-secret-here"
JWT_REFRESH_SECRET="generate-another-long-secure-random-secret-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── 3. Production API URLs ───────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL="https://api.bldr.io"

# ─── 4. Production Frontend URLs (CORS & Redirection) ─────────────────────────
STOREFRONT_URL="https://bldr.io"
ADMIN_PORTAL_URL="https://hub.bldr.io"
PROVIDER_PORTAL_URL="https://providers.bldr.io"

# Public environment variables (Available to Next.js clients)
NEXT_PUBLIC_API_URL="https://api.bldr.io"
NEXT_PUBLIC_STOREFRONT_URL="https://bldr.io"

# ─── 5. Production Payment Gateways (REAL KEYS) ────────────────────────────────
# In production, simulation mode MUST be false
PAYMENT_SIMULATION_MODE="false"

# Geidea Production Gateway
GEIDEA_MERCHANT_KEY="your-production-geidea-merchant-key"
GEIDEA_API_PASSWORD="your-production-geidea-api-password"
GEIDEA_BASE_URL="https://api.merchant.geidea.net"
GEIDEA_CHECKOUT_JS_URL="https://checkout.geidea.net/geideaCheckout.min.js"

# Fawry Production Gateway
FAWRY_MERCHANT_CODE="your-production-fawry-merchant-code"
FAWRY_SECURITY_KEY="your-production-fawry-security-key"
FAWRY_BASE_URL="https://www.atfawry.com"

# Default Gateway ('geidea' | 'fawry')
DEFAULT_PAYMENT_GATEWAY="geidea"
DEFAULT_COMMISSION_RATE="0.10"

# ─── 6. Storage & Uploads ─────────────────────────────────────────────────────
UPLOAD_DEST="./uploads"
MAX_FILE_SIZE_MB="10"

# ─── 7. Super Admin Seed Account ──────────────────────────────────────────────
ADMIN_SEED_EMAIL="admin@bldr.io"
ADMIN_SEED_PASSWORD="ChangeMeInProduction123!"
